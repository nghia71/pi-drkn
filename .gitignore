# --- Problem data must never enter this repository (see scripts/guard.py) ---
data/
staging/
exports/
figures/
*.docx
*.doc
*.pdf
*.wmf
*.emf
*.png
*.jpg
*.jpeg
*.svg
*.tikz
*.xlsx
*.csv
# JSON is data unless it is an Apps Script manifest, an npm file or a fixture
*.json
!apps/*/appsscript.json
!package.json
!package-lock.json
!tests/fixtures/*.json

# --- clasp: project ids stay local ---
.clasp.json
.clasprc.json
apps/*/.clasp.json
deploy.local.env

# --- tooling ---
node_modules/
__pycache__/
*.pyc
.DS_Store
apps/main/ui/RenderJs.html
apps/main/Build.gs
# tệp phụ khi dựng slide (docs/guide)
docs/guide/*.aux
docs/guide/*.log
docs/guide/*.nav
docs/guide/*.out
docs/guide/*.snm
docs/guide/*.toc
docs/guide/*.vrb
out/
# tệp phụ khi dựng slide hướng dẫn (docs/huong-dan)
docs/huong-dan/*/*.aux
docs/huong-dan/*/*.log
docs/huong-dan/*/*.nav
docs/huong-dan/*/*.out
docs/huong-dan/*/*.snm
docs/huong-dan/*/*.toc
docs/huong-dan/*/*.vrb
